diff --git a/web/synth/dx7core.c b/web/synth/dx7core.c
--- a/web/synth/dx7core.c
+++ b/web/synth/dx7core.c
@@ -67,6 +67,16 @@ static FM1_DSP_DATA const u8 algorithms[32][FM_OP_CNT] = {
     { 0xc4, 0x04, 0x04, 0x04, 0x04, 0x04 }, // 32
 };
 
+#ifdef __wasm__
+__attribute__((export_name("sim_fm_carriers")))
+#endif
+unsigned sim_fm_carriers(unsigned algorithm)
+{
+    const u8 *flags = algorithms[algorithm & 31U];
+    unsigned mask = 0;
+    for (unsigned op = 0; op < FM_OP_CNT; ++op)
+        if ((flags[op] & 3U) == 0) mask |= 1U << (5U - op);
+    return mask;
+}

+/* FM1 Instrument home: four sound patches, one per physical knob.
+ * Turning KNOB 1..4 selects the matching patch; the piano keys play the selected patch.
+ * The four tiles show each patch's own voice name and mute state. */
+static void draw_home_instrument(void)
+{
+    static const int8_t WAVE[16] = {0, 2, 5, 3, -1, -4, -2, 1, 4, 2, -2, -5, -1, 3, 4, 0};
+    uint32_t k, i;
+    for (k = 0; k < NTRK; k++) {
+        const track_t *t = &trk[k];
+        int32_t x = 8 + (int32_t)(k & 1u) * 116;
+        int32_t y = 6 + (int32_t)(k >> 1u) * 58;
+        uint32_t selected = k == song.sel;
+        uint32_t muted = t->p[P_MUTE] != 0;
+        uint16_t bg = selected ? T_THEME : T_SURF;
+        uint16_t fg = selected ? T_INK : muted ? T_DIM : T_TEXT;
+        uint16_t wave = selected ? T_INK : muted ? T_DIM : T_MID;
+        char name[16], label[8] = {'P', 'A', 'T', 'C', 'H', ' ', (char)('1' + k), 0};
+        if (t->eng_req % NENGINES == ENGI_FM6) {
+            for (i = 0; i < 10u; i++)
+                name[i] = (char)fm6_patch[k][FP_NAME + i];
+            name[10] = 0;
+            for (i = 10u; i && name[i - 1u] == ' '; i--)
+                name[i - 1u] = 0;
+            if (!name[0])
+                trk_short_name(k, name);
+        } else {
+            trk_short_name(k, name);
+        }
+        cv_rrect(x, y, 108, 52, 4, bg, selected ? T_ACCENT : T_RAISE);
+        cv_text_in(x + 6, y + 4, 66, &AF_S, label, selected ? T_INK : T_MID, bg);
+        cv_text_in(x + 6, y + 17, 96, &AF_M, name, fg, bg);
+        cv_text_in(x + 80, y + 4, 22, &AF_S, muted ? "OFF" : "ON", muted ? T_DIM : T_MID, bg);
+        for (i = 0; i < 15u; i++) {
+            int32_t x0 = x + 7 + (int32_t)i * 6;
+            int32_t y0 = y + 40 - (int32_t)WAVE[i] * 2;
+            int32_t y1 = y + 40 - (int32_t)WAVE[i + 1u] * 2;
+            cv_line_t(x0, y0, x0 + 6, y1, wave, 1);
+        }
+    }
+}
